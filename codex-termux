#!/data/data/com.termux/files/usr/bin/bash

set -Eeuo pipefail

readonly PROGRAM=${0##*/}
readonly VERSION="0.1.0"

runtime_dir=""
proxy_pid=""
proxy_port=""
proxy_url=""
ca_bundle=""
node_bin=""
declare -a codex_command=()

say() {
  printf '%s\n' "$*"
}

note() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

die() {
  note "error: $*"
  exit 1
}

usage() {
  cat <<EOF
Usage:
  $PROGRAM [CODEX_ARGUMENTS...]
  $PROGRAM run [CODEX_ARGUMENTS...]
  $PROGRAM chatgpt [CODEX_ARGUMENTS...]
  $PROGRAM login [LOGIN_ARGUMENTS...]
  $PROGRAM login-api
  $PROGRAM status
  $PROGRAM logout
  $PROGRAM doctor [DOCTOR_ARGUMENTS...]
  $PROGRAM test
  $PROGRAM setup

Run Codex's Linux ARM64 npm build in native Termux through a temporary,
loopback-only HTTPS CONNECT proxy. The proxy lets Termux's native Node.js
resolver perform DNS and is removed automatically when Codex exits.

Commands:
  run       Start Codex. This is the default when no command is supplied.
  chatgpt   Start Codex while ignoring API-key environment variables.
  login     Sign in with ChatGPT device authorization by default.
  login-api Sign in using OPENAI_API_KEY from the environment.
  status    Show the active Codex authentication method.
  logout    Remove stored Codex credentials.
  doctor    Run "codex doctor --all" unless other options are supplied.
  test      Test Node DNS, the local proxy, and Codex connectivity.
  setup     Install missing Termux dependencies and Codex when absent.

Any unrecognized command or option is passed directly to Codex.

Environment:
  CODEX_TERMUX_CODEX_BIN    Override the Codex executable.
  CODEX_TERMUX_PROXY_ALLOW  Extra proxy hostnames, comma-separated.

Examples:
  $PROGRAM setup
  $PROGRAM test
  $PROGRAM login
  $PROGRAM
  $PROGRAM exec --full-auto 'run the tests'
  $PROGRAM chatgpt
EOF
}

is_termux() {
  [[ -n ${TERMUX_VERSION:-} || ${PREFIX:-} == /data/data/*/files/usr ]]
}

require_termux() {
  is_termux || die "this script is intended to run inside Termux"
  [[ -n ${PREFIX:-} && -d $PREFIX/bin ]] || die "Termux PREFIX is unavailable"
}

find_ca_bundle() {
  local candidate

  for candidate in \
    "$PREFIX/etc/tls/cert.pem" \
    "$PREFIX/etc/ssl/cert.pem" \
    "$PREFIX/etc/ssl/certs/ca-certificates.crt"
  do
    if [[ -s $candidate ]]; then
      ca_bundle=$candidate
      return 0
    fi
  done

  return 1
}

resolve_node() {
  node_bin=$(command -v node 2>/dev/null || true)
  [[ -n $node_bin && -x $node_bin ]]
}

resolve_codex() {
  local candidate=""
  local npm_launcher="$PREFIX/lib/node_modules/@openai/codex/bin/codex.js"

  codex_command=()

  if [[ -n ${CODEX_TERMUX_CODEX_BIN:-} ]]; then
    [[ -x $CODEX_TERMUX_CODEX_BIN ]] || return 1
    codex_command=("$CODEX_TERMUX_CODEX_BIN")
    return 0
  fi

  if [[ -r $npm_launcher ]] && resolve_node; then
    codex_command=("$node_bin" "$npm_launcher")
    return 0
  fi

  candidate=$(type -P codex 2>/dev/null || true)
  [[ -n $candidate && -x $candidate ]] || return 1

  if command -v readlink >/dev/null 2>&1; then
    [[ $(readlink -f "$candidate") != $(readlink -f "$0") ]] || return 1
  fi

  codex_command=("$candidate")
}

cleanup() {
  local exit_status=$?

  trap - EXIT

  if [[ -n $proxy_pid ]] && kill -0 "$proxy_pid" 2>/dev/null; then
    kill "$proxy_pid" 2>/dev/null || true
    wait "$proxy_pid" 2>/dev/null || true
  fi

  if [[ -n $runtime_dir && -d $runtime_dir ]]; then
    rm -f -- \
      "$runtime_dir/port" \
      "$runtime_dir/proxy.log"
    rmdir -- "$runtime_dir" 2>/dev/null || true
  fi

  exit "$exit_status"
}

start_proxy() {
  local attempt
  local proxy_ready
  local proxy_log
  local temp_base=${TMPDIR:-"$PREFIX/tmp"}

  mkdir -p -- "$temp_base"
  runtime_dir=$(mktemp -d "$temp_base/codex-termux.XXXXXXXX") ||
    die "could not create a temporary runtime directory"

  proxy_ready="$runtime_dir/port"
  proxy_log="$runtime_dir/proxy.log"
  : >"$proxy_log"
  chmod 600 "$proxy_log"

  env \
    -u OPENAI_API_KEY \
    -u CODEX_API_KEY \
    -u CODEX_ACCESS_TOKEN \
    CODEX_PROXY_READY="$proxy_ready" \
    CODEX_TERMUX_PROXY_ALLOW="${CODEX_TERMUX_PROXY_ALLOW:-}" \
    "$node_bin" - >>"$proxy_log" 2>&1 <<'NODE' &
const fs = require("node:fs");
const http = require("node:http");
const net = require("node:net");

const readyFile = process.env.CODEX_PROXY_READY;
const defaultHosts = [
  "openai.com",
  "chatgpt.com",
  "oaistatic.com",
  "oaiusercontent.com",
];
const extraHosts = (process.env.CODEX_TERMUX_PROXY_ALLOW || "")
  .split(",")
  .map((host) => host.trim().toLowerCase().replace(/^\*?\./, ""))
  .filter(Boolean);
const allowedHosts = [...new Set([...defaultHosts, ...extraHosts])];

function normalizeHost(host) {
  return host.trim().toLowerCase().replace(/\.$/, "");
}

function hostIsAllowed(host) {
  const normalized = normalizeHost(host);
  return allowedHosts.some(
    (allowed) => normalized === allowed || normalized.endsWith(`.${allowed}`),
  );
}

function reject(client, status, reason) {
  client.end(
    `HTTP/1.1 ${status} ${reason}\r\nConnection: close\r\nContent-Length: 0\r\n\r\n`,
  );
}

const server = http.createServer((_request, response) => {
  response.writeHead(405, { Connection: "close", "Content-Length": "0" });
  response.end();
});

server.on("connect", (request, client, head) => {
  let target;

  try {
    target = new URL(`http://${request.url}`);
  } catch {
    reject(client, 400, "Bad Request");
    return;
  }

  const host = normalizeHost(target.hostname);
  const port = Number(target.port || 443);

  if (!hostIsAllowed(host)) {
    reject(client, 403, "Forbidden");
    return;
  }

  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    reject(client, 400, "Bad Request");
    return;
  }

  let established = false;
  const upstream = net.connect({ host, port }, () => {
    established = true;
    client.write("HTTP/1.1 200 Connection Established\r\n\r\n");

    if (head.length) upstream.write(head);

    client.pipe(upstream);
    upstream.pipe(client);
  });

  upstream.on("error", () => {
    if (client.destroyed) return;
    if (established) client.destroy();
    else reject(client, 502, "Bad Gateway");
  });

  client.on("error", () => upstream.destroy());
  client.on("close", () => upstream.destroy());
});

server.on("error", (error) => {
  console.error(`proxy error: ${error.message}`);
  process.exitCode = 1;
});

server.listen(0, "127.0.0.1", () => {
  const address = server.address();
  fs.writeFileSync(readyFile, `${address.port}\n`, { mode: 0o600 });
});
NODE

  proxy_pid=$!

  for ((attempt = 0; attempt < 50; attempt++)); do
    if [[ -s $proxy_ready ]]; then
      break
    fi

    if ! kill -0 "$proxy_pid" 2>/dev/null; then
      note "the local proxy exited during startup"
      tail -n 20 "$proxy_log" >&2 || true
      return 1
    fi

    sleep 0.1
  done

  [[ -s $proxy_ready ]] || {
    note "timed out waiting for the local proxy"
    tail -n 20 "$proxy_log" >&2 || true
    return 1
  }

  IFS= read -r proxy_port <"$proxy_ready"
  [[ $proxy_port =~ ^[0-9]+$ ]] || die "the local proxy returned an invalid port"
  proxy_url="http://127.0.0.1:$proxy_port"
}

run_codex() {
  env \
    HTTPS_PROXY="$proxy_url" \
    https_proxy="$proxy_url" \
    NO_PROXY="127.0.0.1,localhost" \
    no_proxy="127.0.0.1,localhost" \
    CODEX_CA_CERTIFICATE="$ca_bundle" \
    SSL_CERT_FILE="$ca_bundle" \
    "${codex_command[@]}" "$@"
}

run_codex_chatgpt() {
  env \
    -u OPENAI_API_KEY \
    -u CODEX_API_KEY \
    -u CODEX_ACCESS_TOKEN \
    HTTPS_PROXY="$proxy_url" \
    https_proxy="$proxy_url" \
    NO_PROXY="127.0.0.1,localhost" \
    no_proxy="127.0.0.1,localhost" \
    CODEX_CA_CERTIFICATE="$ca_bundle" \
    SSL_CERT_FILE="$ca_bundle" \
    "${codex_command[@]}" "$@"
}

install_codex() {
  local platform_package

  case $(uname -m) in
    aarch64 | arm64)
      platform_package='@openai/codex-linux-arm64@npm:@openai/codex@linux-arm64'
      ;;
    x86_64 | amd64)
      platform_package='@openai/codex-linux-x64@npm:@openai/codex@linux-x64'
      ;;
    *)
      die "Codex's npm package is unavailable for architecture $(uname -m)"
      ;;
  esac

  npm install -g --force \
    '@openai/codex@latest' \
    "$platform_package"
}

setup() {
  local -a packages=()
  local npm_launcher="$PREFIX/lib/node_modules/@openai/codex/bin/codex.js"

  if ! command -v node >/dev/null 2>&1 ||
    ! command -v npm >/dev/null 2>&1
  then
    packages+=(nodejs)
  fi
  command -v curl >/dev/null 2>&1 || packages+=(curl)
  find_ca_bundle || packages+=(ca-certificates)

  if ((${#packages[@]})); then
    note "installing missing Termux packages: ${packages[*]}"
    pkg install -y "${packages[@]}"
    hash -r
  fi

  resolve_node || die "Node.js is still unavailable after setup"
  find_ca_bundle || die "Termux's CA certificate bundle is still unavailable"

  if [[ -z ${CODEX_TERMUX_CODEX_BIN:-} && ! -r $npm_launcher ]]; then
    note "installing the current Codex npm package"
    install_codex
    hash -r
  elif ! resolve_codex || ! "${codex_command[@]}" --version >/dev/null 2>&1; then
    note "repairing the Codex npm installation"
    install_codex
    hash -r
  fi

  resolve_codex || die "Codex is still unavailable after setup"
  say "Setup complete. Next run: $PROGRAM test"
}

test_connection() {
  local http_code

  note "testing Android DNS through Termux Node.js"
  "$node_bin" -e '
    require("node:dns").lookup("auth.openai.com", (error, address, family) => {
      if (error) {
        console.error(`DNS failed: ${error.message}`);
        process.exitCode = 1;
        return;
      }
      console.log(`DNS OK: ${address} (IPv${family})`);
    });
  '

  command -v curl >/dev/null 2>&1 ||
    die "curl is required for the connection test; run: $PROGRAM setup"

  note "testing HTTPS through $proxy_url"
  http_code=$(curl \
    --proxy "$proxy_url" \
    --cacert "$ca_bundle" \
    --connect-timeout 10 \
    --max-time 20 \
    --silent \
    --show-error \
    --output /dev/null \
    --write-out '%{http_code}' \
    https://auth.openai.com/) ||
    die "the HTTPS proxy test failed"

  [[ $http_code =~ ^[1-5][0-9][0-9]$ ]] ||
    die "auth.openai.com did not return an HTTP response"

  say "HTTPS OK: auth.openai.com returned HTTP $http_code"
  note "running Codex Doctor"
  run_codex doctor --summary
}

main() {
  local action=${1:-run}

  case $action in
    -h | --help | help)
      usage
      return 0
      ;;
    setup)
      shift
      (($# == 0)) || die "setup does not accept arguments"
      require_termux
      setup
      return 0
      ;;
  esac

  require_termux
  resolve_node || die "Node.js is required; run: $PROGRAM setup"
  find_ca_bundle || die "Termux's CA bundle is missing; run: $PROGRAM setup"
  resolve_codex || die "Codex is required; run: $PROGRAM setup"

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  start_proxy || die "could not start the local proxy"

  case $action in
    run)
      shift
      run_codex "$@"
      ;;
    chatgpt)
      shift
      run_codex_chatgpt "$@"
      ;;
    login)
      shift
      if (($#)); then
        run_codex_chatgpt login "$@"
      else
        run_codex_chatgpt login --device-auth
      fi

      if [[ -n ${OPENAI_API_KEY:-}${CODEX_API_KEY:-}${CODEX_ACCESS_TOKEN:-} ]]; then
        note "API credential variables remain set in your shell"
        note "use '$PROGRAM chatgpt' to force the stored ChatGPT login"
      fi
      ;;
    login-api)
      shift
      (($# == 0)) || die "login-api does not accept arguments"
      [[ -n ${OPENAI_API_KEY:-} ]] ||
        die "OPENAI_API_KEY is not set"
      printf '%s\n' "$OPENAI_API_KEY" | run_codex login --with-api-key
      ;;
    status)
      shift
      (($# == 0)) || die "status does not accept arguments"
      run_codex login status
      ;;
    logout)
      shift
      (($# == 0)) || die "logout does not accept arguments"
      run_codex_chatgpt logout
      ;;
    doctor)
      shift
      if (($#)); then
        run_codex doctor "$@"
      else
        run_codex doctor --all
      fi
      ;;
    test)
      shift
      (($# == 0)) || die "test does not accept arguments"
      test_connection
      ;;
    *)
      run_codex "$@"
      ;;
  esac
}

main "$@"
