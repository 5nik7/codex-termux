# Literal key=value; never shell code. Do not quote or expand paths.
auto_update=ask
update_interval=86400
color=auto
banner=auto
output=auto
proxy_connect_timeout=10000
auth_notice=auto
# auth_log=/absolute/path/to/codex-tui.log
# proxy_allow=example.com
# codex_bin=/absolute/path/to/codex
# ca_bundle=/absolute/path/to/cert.pem

# Management and connections use the existing codex-remote service by default.
# Select managed explicitly to retain the legacy Node supervisor.
connect_backend=runit
runit_port=4511
